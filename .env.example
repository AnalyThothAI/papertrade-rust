# Master wallet addresses of the two dedicated accounts. Addresses only: no
# private key and no password ever goes in this file. They are typed at the
# terminal (`papertrade keys init`, then once at every `papertrade run`).
# Leave a variable commented out to keep it unset; an empty value is an error.
PT_LONG_ACCOUNT=0x0000000000000000000000000000000000000001
PT_SHORT_ACCOUNT=0x0000000000000000000000000000000000000002

# Encrypted keys live here: <wallet>.session.json, and <wallet>.wallet.json
# with the wallet automation on. Created by `papertrade keys init`.
# PT_KEYS_DIR=./secrets

# The database lives here as papertrade.db.
# PT_DATA_DIR=./data

# Strategy
PT_COIN=BTC
# PT_NOTIONAL_USD=10000
# PT_LEVERAGE=20
# Close both legs once price is this far from the entry. Left unset, it is 100.
PT_CLOSE_BPS=50
# PT_REQUIRE_EMPTY_QUEUE=true

# Lifetime of each signed open/close. Short on purpose: it bounds how long an
# intent with an unknown outcome can still execute.
# PT_INTENT_TTL_SECONDS=120

# false = live: `run` signs and submits real orders with real funds, and with
# the settings below real registrations and transfers too.
# true = decide and record, never sign or submit. Covers everything `run` does.
# Left unset, it is true.
PT_DRY_RUN=false

# true = the bot also holds the two wallets' own keys: `keys init` asks for
# them, and `run` then registers and renews the session keys by itself. Such a
# key signs registrations, withdrawals to its own HyperCore account and
# transfers to the other account's deposit address, nothing else. By itself
# this moves no funds: that takes PT_REBALANCE as well. None of it has run
# against the real exchange yet: see README.
# false = session keys only: the wallets' keys are never asked for or read, and
# the session keys are registered by hand. Left unset, it is false.
PT_WALLET_AUTOMATION=true

# true = the bot moves funds from the richer account to the poorer one when one
# of them can no longer cover its margin and one round's loss. Needs
# PT_WALLET_AUTOMATION=true. Off, no transfer is started; one that has started
# already is still carried to its end.
PT_REBALANCE=false
