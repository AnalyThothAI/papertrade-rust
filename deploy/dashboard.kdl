// Zellij layout for watching the bot: the dashboard on top, the service log below.
// From the main checkout:
//   zellij --layout deploy/dashboard.kdl                      (a new session)
//   zellij action new-tab --layout deploy/dashboard.kdl       (a tab in the session you are in)
// Closing it does not stop the bot; the bot runs as a systemd user service.
layout {
    pane split_direction="horizontal" {
        pane size="72%" name="papertrade" command="./target/release/papertrade" {
            args "tui"
        }
        pane name="log" command="journalctl" {
            args "--user" "-u" "papertrade" "-f" "-n" "30" "-o" "cat"
        }
    }
}
