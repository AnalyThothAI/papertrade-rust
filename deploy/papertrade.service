# systemd user unit for the bot. Install with the commands in README.md, which
# replace @REPO@ with the path of the main checkout.

[Unit]
Description=Papertrade hedged PAPER farming bot
# Keep restarting for as long as it takes; never give up after repeated failures.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=@REPO@
ExecStart=@REPO@/target/release/papertrade run
# The bot is safe to restart at any time: it takes over from the account state
# and its intent journal. It exits on purpose when one of its feeds dies.
Restart=always
RestartSec=5
# Like Ctrl-C: the bot finishes the tick it is in, then exits.
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
